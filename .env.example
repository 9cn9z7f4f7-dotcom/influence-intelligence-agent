# Скопируйте в .env и заполните при наличии доступов.
# Проект полностью работает и без этих ключей (demo-режим, без интернета).

# Режим работы: demo (по умолчанию, без интернета) | live (+ попытка опросить YouTube/web)
APP_MODE=demo

# YouTube Data API v3 - опционально. Без ключа YouTube adapter помечается
# unavailable и pipeline продолжает работать на demo dataset.
YOUTUBE_API_KEY=

# Anthropic API - опционально. Без ключа Competitor DNA / Our Move возвращают
# computed-паттерны без LLM-переформулировки (без "красивого текста"), но со
# всеми теми же цифрами и evidence.
ANTHROPIC_API_KEY=

# --- Real-data update (см. README/REAL_DATA_VALIDATION.md) ------------------
# OpenRouter - text/vision enrichment для ambiguous-детекций (VisualEvidenceEnricher).
# Опционально. Без ключа - visual_ai_status=unavailable, deterministic fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=

# Реальный (не fake) search backend для Articles/Web платформы. Опционально.
# Tavily - PRIMARY provider (точечная доработка); SerpAPI - FALLBACK, если
# Tavily не задан/недоступен (timeout/401/quota/невалидный ответ). Если ни
# один ключ не задан - платформа "articles" честно unavailable + import
# fallback (никакого demo/synthetic).
TAVILY_API_KEY=
SERPAPI_KEY=

# Local connector (Instagram/TikTok, см. LOCAL_CONNECTOR.md). Опционально -
# shared secret, которым local_connector/run.py авторизуется при регистрации.
CONNECTOR_SHARED_SECRET=
CONNECTOR_OFFLINE_AFTER_SECONDS=90

# Local connector (запускается НА МАКЕ пользователя, НЕ здесь) - URL этого
# Render-инстанса, к которому connector будет ходить.
RENDER_BASE_URL=http://localhost:8000
