# Скопируйте в .env и заполните при наличии доступов.
# Проект полностью работает и без этих ключей (demo-режим, без интернета).

# Режим работы: demo (по умолчанию, без интернета) | live (+ попытка опросить YouTube/web)
APP_MODE=demo

# YouTube Data API v3 - опционально. Без ключа YouTube adapter помечается
# unavailable и pipeline продолжает работать на demo dataset.
YOUTUBE_API_KEY=

# Anthropic API - опционально. Без ключа Competitor DNA / Our Move возвращают
# computed-паттерны без LLM-переформулировки (без "красивого текста"), но со
# всеми теми же цифрами и evidence.
ANTHROPIC_API_KEY=
